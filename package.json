{
  "name": "claude-works",
  "version": "0.1.0",
  "private": true,
  "description": "Base de conhecimento do ecossistema de desenvolvimento de Cleber Costa Santos, feita para o Claude ler gastando poucos tokens.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "validar": "node scripts/validar-kb.mjs",
    "indice": "node scripts/indice.mjs",
    "tokens": "node scripts/tokens.mjs",
    "modelo": "node scripts/modelo.mjs",
    "iniciar-repositorio": "node scripts/iniciar-repositorio.mjs",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"scripts/**/*.mjs\" --test-coverage-include=\"utils/**/*.mjs\" --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 \"tests/**/*.test.mjs\""
  }
}
